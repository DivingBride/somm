# Copy this file to .env and fill in your values
# Never commit .env to git

# --- v1 (legacy — still honored by /ask during the v1 → v2 transition) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
APP_PASSWORD=choose-a-strong-password
SOMM_DATA_PATH=../somm

# --- v2.0 Phase 0: database + auth ---
# SQLite file; Render mounts a persistent disk at /var/data in prod.
# Locally this falls back to ./somm.db in the app directory.
# DATABASE_URL=sqlite+aiosqlite:////var/data/somm.db

# Required — used to sign session cookies. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=

# Cookie Secure flag — must be true in prod (HTTPS). Set to false locally.
COOKIE_SECURE=true

# Public URL of the app; used to build magic-link callback URLs.
APP_URL=http://localhost:8000

# Resend (§13 decision 1). Free tier covers our volume; Postmark is the fallback.
# Leave RESEND_API_KEY blank in dev — magic links will be printed to stdout.
RESEND_API_KEY=
FROM_EMAIL=Somm <onboarding@resend.dev>
