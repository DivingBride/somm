# Copy this file to .env and fill in your values. .env is gitignored.
#
# Two profiles:
#   LOCAL DEV  — defaults work; magic links are printed to stdout
#                instead of emailed.
#   PRODUCTION — set every variable below. `./scripts/prod-dryrun.sh`
#                runs the app locally using the same environment shape
#                as Render, so you can catch misconfiguration before
#                pushing.

# ============================================================
# Required — Anthropic API
# ============================================================
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ============================================================
# Required in prod — session cookie signing
# ============================================================
# Generate once per environment with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# The app falls back to a dev secret with a loud warning if blank.
SESSION_SECRET=

# ============================================================
# Required in prod — Resend email (magic links, 5xx alerts)
# ============================================================
# Leave blank locally; links will be logged to stdout.
RESEND_API_KEY=

# "From" address for magic-link emails. Change this once you verify
# a custom sending domain in Resend.
FROM_EMAIL=Somm <onboarding@resend.dev>

# ============================================================
# Required in prod — founder admin account
# ============================================================
# Created on first boot if no user with this email exists.
ADMIN_EMAIL=
ADMIN_DISPLAY_NAME=

# Comma-separated list of emails that receive 5xx error alerts.
# Falls back to ADMIN_EMAIL if unset.
ADMIN_ALERT_EMAILS=

# ============================================================
# Required in prod — URLs + cookies
# ============================================================
# Public URL, used to construct magic-link callbacks.
APP_URL=http://localhost:8000

# Must be "true" in prod (HTTPS). "false" locally over plain HTTP.
COOKIE_SECURE=false

# ============================================================
# Data paths
# ============================================================
# Somm skill + reference tables + screenshots (bundled in the repo).
SOMM_DATA_PATH=./somm_data

# Chartier xlsx ingested into the library on startup (bundled in the repo).
CHARTIER_XLSX_PATH=./somm_data/Chartier_Wine_Food_Pairings.xlsx

# ============================================================
# Database
# ============================================================
# Leave unset locally → falls back to ./somm.db.
# Prod on Render: sqlite+aiosqlite:////var/data/somm.db
DATABASE_URL=
